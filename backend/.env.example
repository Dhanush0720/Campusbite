PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Direct UPI Configuration (0% fee, direct to canteen bank account)
UPI_PROVIDER_NAME=direct-upi
UPI_MERCHANT_VPA=canteen@upi
UPI_MERCHANT_NAME=CampusBite Canteen

# Optional: Razorpay credentials (leave blank to use Direct UPI & In-House Wallet)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

